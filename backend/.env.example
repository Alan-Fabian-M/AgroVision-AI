# AgroVisionAI - Plantilla de Configuración del Backend (.env.example)
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a `.env` en este mismo directorio.
# 2. Rellena los valores reales de configuración en el archivo `.env`.
# 3. ¡NUNCA subas el archivo `.env` resultante a GitHub!

# --- Entorno y Depuración ---
ENV=development
DEBUG=True

# --- Clave Secreta ---
# Genera una clave segura para producción
SECRET_KEY=tu_clave_secreta_aqui

# --- Servidor ---
HOST=127.0.0.1
PORT=8000

# --- Base de Datos ---
DATABASE_URL=sqlite:///db.sqlite3

# O configuración de base de datos relacional:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=agrovision_db
DB_USER=postgres
DB_PASSWORD=contrasena_aqui
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Seguridad y CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- APIs de Terceros ---
# OPENAI_API_KEY=
# CLOUDINARY_URL=
