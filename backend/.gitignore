# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you probably want to ignore it.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you want to exclude it, uncomment the following line.
#Pipfile.lock

# poetry
#   According to poetry markup, the poetry.lock file should be committed to version control.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#   poetry.lock

# pdm
#   Similar to Pipfile.lock / poetry.lock, pdm.lock should be committed to version control
#   https://pdm.fming.dev/latest/usage/project/#commit-the-lock-file
#pdm.lock
#   pdm local configuration
.pdm-python.path
.pdm-build/

